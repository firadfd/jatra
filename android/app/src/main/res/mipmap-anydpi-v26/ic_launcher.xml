<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+). Android masks the foreground to whatever shape the
  launcher uses, so the mark is drawn inset into the safe zone and the ink
  background fills the rest. Older devices fall back to the flat
  mipmap-*/ic_launcher.png files.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
