<?xml version="1.0" encoding="utf-8"?>
<!--
  Only ever seen in the widget picker's preview and in the moment between
  dropping the widget on a home screen and the app next running. Once Flutter
  has rendered a face, the face carries its own surface and this is hidden.

  Radii.card (16dp), so the placeholder and the rendered face have the same
  silhouette.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/jatra_widget_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/jatra_widget_border" />
    <corners android:radius="16dp" />
</shape>
