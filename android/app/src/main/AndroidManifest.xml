<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Jatra requests no permission of its own. Service reminders are posted by
      flutter_local_notifications, which contributes POST_NOTIFICATIONS plus
      the two below, which we do not use and therefore remove.

      POST_NOTIFICATIONS is asked for at two moments, both of them things the
      user just did: switching service reminders on, and starting a ride.
      The second is not obvious — the recording notification is posted by the
      location foreground service, not by us — but since Android 13 a
      foreground service notification is suppressed like any other when the
      permission is missing. The ride would record with nothing in the shade
      to show for it. See `NotificationService.ensureAllowed`.

        SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM — reminders are scheduled with
        AndroidScheduleMode.inexactAllowWhileIdle. A service due "sometime
        this week" does not need to wake the device to the second, and
        declaring exact alarms would trigger a Play Store declaration form
        for no benefit.

        RECEIVE_BOOT_COMPLETED — we recompute and reschedule on every app
        launch, so surviving a reboot in the scheduler is unnecessary.
    -->
    <!--
      Map tiles, and nothing else.

      Jatra has no account, no server of its own and no analytics. The one
      network call it makes is fetching OpenStreetMap raster tiles to draw
      behind a recorded ride, which sends the tile coordinates of that ride
      to openstreetmap.org. Every other feature — fuel, service, expenses,
      statistics, backups, reminders — works with the radio off.

      This must live in the main manifest: Flutter's generated debug and
      profile manifests declare it too, so leaving it out here still shows
      tiles in development and silently shows none in a release build.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <!--
      Ride tracking (Phase 6). All of these are runtime permissions and none
      is requested until the user switches tracking on in settings — the
      default is Off, and the app is fully usable that way.

      A ride records from Start to Finish, not from foreground to background:
      the position stream runs behind geolocator's GeolocatorLocationService,
      which its own manifest declares with foregroundServiceType="location".
      FOREGROUND_SERVICE_LOCATION is what Android 14+ requires to start a
      service of that type, so both lines below are load-bearing.

      ACCESS_BACKGROUND_LOCATION triggers a manual Play Store review with a
      declaration form and a demo video. Strictly, a location foreground
      service started while the app is on screen keeps receiving fixes on a
      while-in-use grant alone — which covers a ride begun by tapping Start.
      This is here for the edges that grant does not cover, and its absence
      degrades reliability rather than breaking recording; see
      `tracking_section.dart`.

      GPS only — Jatra has no use for the network-based coarse location, and
      asking for less is asking for less.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      Required by `enableWakeLock` in the ForegroundNotificationConfig that
      starts the recording service — geolocator asks the system for a
      PowerManager wake lock and the platform throws a SecurityException
      ("Neither user nor current process has android.permission.WAKE_LOCK")
      the moment the position stream opens without this line. geolocator does
      not declare it in its own manifest, and wakelock_plus does not
      contribute it either: that plugin only sets FLAG_KEEP_SCREEN_ON on the
      window, which needs no permission.

      The wake lock is what keeps the CPU awake between fixes. Without it the
      device sleeps mid-ride and location events arrive in a clump at the next
      wake, which is the batched, lurching track this feature exists to avoid.

      Normal protection level: granted at install, no runtime prompt, no Play
      Store declaration.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Jatra does not use coarse location, and geolocator contributes it by
      default. Removed so the Play listing does not claim an access the app
      never makes.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />

    <!-- GPS is required for this feature; the app does not fall back to
         network positioning. Marked not-required so the Play listing stays
         open to devices without it, since every other feature works. -->
    <uses-feature android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="Jatra"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          Home-screen widgets — five of them, so a rider can put a single
          chart on a home screen without the other two and four figures
          coming along. They share one implementation; see JatraWidgets.kt.

          All exported, because the AppWidget framework delivers
          APPWIDGET_UPDATE as a broadcast from the system and some launchers
          will not bind a provider that is not. Nothing is exposed by that:
          each receiver reads a PNG out of the app's own files directory and
          hands it to the system to draw. They accept no data, and there is
          no other action in the filter to send them.
        -->
        <receiver
            android:name=".JatraStatsWidget"
            android:exported="true"
            android:label="@string/jatra_widget_all_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jatra_stats_widget_info" />
        </receiver>

        <receiver
            android:name=".JatraInfoWidget"
            android:exported="true"
            android:label="@string/jatra_widget_info_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jatra_info_widget_info" />
        </receiver>

        <receiver
            android:name=".JatraSpendWidget"
            android:exported="true"
            android:label="@string/jatra_widget_spend_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jatra_spend_widget_info" />
        </receiver>

        <receiver
            android:name=".JatraDistanceWidget"
            android:exported="true"
            android:label="@string/jatra_widget_distance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jatra_distance_widget_info" />
        </receiver>

        <receiver
            android:name=".JatraFuelCostWidget"
            android:exported="true"
            android:label="@string/jatra_widget_fuel_cost_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jatra_fuel_cost_widget_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
